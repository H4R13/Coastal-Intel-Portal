# Copy to .env and fill in. .env is never committed.

# PostgreSQL (with PostGIS)
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# Redis / Memurai cache (optional: without it answers come straight from the database)
REDIS_URL=redis://localhost:6379

# Assistant (chat under the map). Default: a local model through Ollama, no key needed.
# OLLAMA_URL=http://localhost:11434      # point at another machine running Ollama, e.g. the office PC
# OLLAMA_MODEL=hermes3:8b                # default: best installed of qwen3:8b, qwen3:4b, qwen2.5, llama3, qwen3:1.7b
# ASSISTANT_PROVIDER=ollama              # ollama | anthropic (anthropic is chosen automatically when a key is set)
# ANTHROPIC_API_KEY=                     # optional: use Claude instead (paid per question)
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium

# PORT=5173
# PORTAL_DATA_ROOT=                      # folder holding data/, Other Data/ and the caches, if not this folder
# OLLAMA_THREADS=16                      # processor threads the local model may use (default: Ollama chooses)
