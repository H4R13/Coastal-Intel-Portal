{
  "name": "coastal-hazards-2",
  "private": true,
  "type": "module",
  "description": "React + Node version of the Nereus Sentinel portal (formerly Coastal Environmental Intelligence). Same port (5173), same data API, same database and caches as the original.",
  "scripts": {
    "start": "vite build && node server.mjs",
    "serve": "node server.mjs",
    "build": "vite build",
    "dev": "node dev.mjs",
    "db:start": "node server/pg.mjs start",
    "db:stop": "node server/pg.mjs stop",
    "db:status": "node server/pg.mjs status",
    "load:mangroves": "node run.mjs server/load-mangroves.mjs",
    "load:erosion": "node run.mjs server/load-erosion.mjs",
    "load:ocean": "node run.mjs server/load-ocean.mjs",
    "load:amib": "node run.mjs server/load-amib.mjs",
    "load:dmjm": "node run.mjs server/load-dmjm.mjs",
    "load:nutrients": "node run.mjs server/load-nutrients.mjs",
    "load:ndma": "node server/load-ndma.mjs",
    "load:inja": "node server/load-inja.mjs",
    "room": "node room/server.mjs",
    "fetch:seabass": "node server/fetch-seabass.mjs",
    "load:insitu": "node --max-old-space-size=4096 server/load-insitu.mjs",
    "update:data": "node run.mjs server/update-data.mjs",
    "watch:papers": "node run.mjs server/watch-literature.mjs",
    "warm:mangroves": "node run.mjs server/warm-mangroves.mjs",
    "warm:amib": "node run.mjs server/warm-amib.mjs",
    "share:pc": "node share-for-pc.mjs",
    "push:cloud":"node run.mjs server/push-to-cloud.mjs",
    "hela:eval": "node run.mjs server/assistant/eval.mjs",
    "hela:review": "node run.mjs server/assistant/review.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "chart.js": "^4.4.4",
    "geotiff": "^2.1.3",
    "ioredis": "^5.4.1",
    "maplibre-gl": "5.6.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
